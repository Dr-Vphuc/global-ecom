# ---------------------------------------------------------------------------
# Nguyen tac #5: KHONG commit du lieu tho. Chi commit script tai va file nhe.
# ---------------------------------------------------------------------------

# Du lieu tho lon — tai lai bang huong dan trong README
data/atlas/*.csv
data/raw/
# File tai do dang va file hong do src/download_atlas.py giu lai.
# Duoi .part/.broken KHONG khop '*.csv' nen phai ghi rieng.
*.part
*.broken
# ...tru 3 file tra cuu nho, can cho pipeline chay duoc ngay
!data/atlas/location_country.csv
!data/atlas/product_hs92.csv
!data/atlas/hs92_data_dictionary.csv

# File trung gian — sinh lai bang: python src/build_intermediate.py
data/processed/
*.parquet
*.duckdb

# Du lieu gia THI commit, de ca nhom dung chung mot bo
!data/mock/
!data/mock/*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# LaTeX
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.fdb_latexmk
*.fls
*.bbl
*.blg

# File khoa tam cua Excel: Windows sinh ra ~$ten.xlsx khi workbook dang mo, va
# khoa luon file do. Khong loai tru thi `git add -A` HONG CA LENH voi
# "Permission denied", chu khong chi bo qua mot file.
~$*

# Mo hinh 3D va anh xuat ra tu notebooks/ — sinh lai duoc bang
# src/export_cone_tree_glb.py va chay lai notebook, nen khong commit.
# Rieng file .ipynb KHONG chan: de no hien trong git status cho ca nhom thay
# va tu quyet dinh co dua vao repo hay khong.
notebooks/exports/
notebooks/*.pdf
notebooks/*.png

# He dieu hanh / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Bieu do xuat ra tu src/make_hierarchy_charts.py — sinh lai duoc, khong commit.
output/

# San pham bien dich cua ban dich LaTeX (.report/overleaf/render.ps1 dung lai).
.report/overleaf/*.pdf
.report/overleaf/*.xdv

# Goi anh nen de upload Overleaf — chi la ban sao cua img/.
*.zip

# Anh chup va ban ghi cua Playwright khi kiem trang web, khong phai san pham.
.playwright-mcp/
